generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserPlan {
  free
  pro
  business
  enterprise
}

enum WorkspacePlan {
  free
  pro
  business
  enterprise
}

// PRD_AUDIT.md Finding #7: PRD §19 specifies "Data residency selection
// at workspace creation (US/EU/APAC)." This enum and the field it backs
// (Workspace.dataResidency) record the selection honestly, but do NOT
// by themselves relocate any data — this deployment runs a single
// PostgreSQL instance and a single S3-compatible bucket with no
// region-specific infrastructure behind either. Storing a region string
// with nothing behind it would be exactly the kind of "looks like
// compliance, does nothing" gap this audit exists to close.
enum DataResidency {
  us
  eu
  apac
}

enum MemberRole {
  owner
  admin
  member
  guest
}

enum MemberStatus {
  active
  invited
  suspended
  left
}

enum ChannelType {
  public
  private
  direct
}

enum TaskStatus {
  todo
  in_progress
  in_review
  done
  cancelled
}

enum TaskPriority {
  urgent
  high
  medium
  low
}

enum BlockType {
  paragraph
  heading1
  heading2
  heading3
  code
  quote
  callout
  bulleted_list
  numbered_list
  todo
  divider
  image
  file
  embed
  task_embed
  table
  canvas_embed
}

enum EdgeType {
  converted_from
  referenced_in
  mentioned_in
  related_to
  produced_by
  decided_in
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  avatarUrl    String?
  plan         UserPlan  @default(free)
  timezone     String    @default("UTC")
  lockedUntil  DateTime?
  deletedAt    DateTime?
  // Platform-wide super admin flag. Deliberately separate from
  // WorkspaceMember.role, which is workspace-scoped — a workspace owner
  // or admin has zero platform authority by default, and this flag has
  // zero workspace-membership implication. Conflating the two would
  // create exactly the kind of privilege-escalation surface found in the
  // API-key middleware audit (SEC-3/SEC-4): a role check that means
  // something different than what the caller assumes it means.
  // Defaults false; only settable directly in the database or via the
  // grant/revoke endpoints in routes/super-admin/index.ts, which are
  // themselves super-admin-gated (no self-service path exists anywhere).
  isSuperAdmin Boolean   @default(false)
  // PRD_AUDIT.md Finding #9 (onboarding): PRD §14 Flow 1's "Role
  // Selection (PM/Dev/Designer, sets default layout)" step. Nullable
  // because every existing user predates this field and has no role —
  // the onboarding flow only runs for new signups, so backfilling old
  // accounts isn't attempted and isn't needed (their default-landing
  // logic just falls through to the pre-existing unconditional redirect).
  onboardingRole String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspaceMembers  WorkspaceMember[]
  channelMembers    ChannelMember[]
  sentMessages      Message[]
  createdTasks      Task[]             @relation("TaskCreatedBy")
  assignedTasks     Task[]             @relation("TaskAssignee")
  createdDocs       Document[]         @relation("DocCreatedBy")
  lastEditedDocs    Document[]         @relation("DocLastEditedBy")
  auditLogs         AuditLog[]
  workspaceInvites  WorkspaceInvite[]  @relation("InvitedBy")
  documentVersions  DocumentVersion[]
  workGraphEdges    WorkGraphEdge[]    @relation("EdgeCreatedBy")
  notifications     Notification[]
  bookmarks         Bookmark[]
  apiKeys           ApiKey[]
  notificationPrefs UserNotificationPrefs?

  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

// ─── Workspaces ───────────────────────────────────────────────────────────────

model Workspace {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  logoUrl     String?
  plan        WorkspacePlan @default(free)
  ownerId     String
  settings    Json          @default("{}")
  deletedAt   DateTime?
  // Platform-level suspension, distinct from deletedAt. deletedAt expresses
  // "this workspace was removed" (by its own owner, soft-delete, reversible
  // only via direct DB access). suspendedAt expresses "a platform operator
  // paused this tenant" (e.g. ToS violation investigation, non-payment) —
  // fully reversible via the super admin dashboard, and members see an
  // explicit "this workspace has been suspended" state rather than the
  // workspace silently behaving as if deleted. The two are independent:
  // a workspace can be suspended without being deleted, and the suspension
  // check is enforced at the auth/workspace-membership layer, not by
  // reusing deletedAt's existing soft-delete filters anywhere.
  suspendedAt       DateTime?
  suspendedReason   String?
  suspendedById     String?
  // PRD_AUDIT.md Finding #7: recorded honestly at creation time, not
  // enforced at the data-plane level in this single-region deployment.
  dataResidency     DataResidency @default(us)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members      WorkspaceMember[]
  channels     Channel[]
  documents    Document[]
  tasks        Task[]
  projects     Project[]
  canvases     Canvas[]
  invites      WorkspaceInvite[]
  auditLogs    AuditLog[]
  workGraphEdges WorkGraphEdge[]
  ssoConfig      WorkspaceSsoConfig?
  notifications  Notification[]
  apiKeys        ApiKey[]
  webhooks       WebhookEndpoint[]
  scimTokens     ScimToken[]

  @@index([slug])
  @@index([ownerId])
  @@index([deletedAt])
  @@index([suspendedAt])
  @@map("workspaces")
}

model WorkspaceMember {
  id             String       @id @default(cuid())
  workspaceId    String
  userId         String
  role           MemberRole   @default(member)
  status         MemberStatus @default(active)
  joinedAt       DateTime     @default(now())
  lastAccessedAt DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId, status])
  @@index([userId])
  @@map("workspace_members")
}

model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        MemberRole @default(member)
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([token])
  @@index([email])
  @@index([workspaceId])
  @@map("workspace_invites")
}

// ─── Channels ─────────────────────────────────────────────────────────────────

model Channel {
  id          String      @id @default(cuid())
  workspaceId String
  name        String
  description String?
  type        ChannelType @default(public)
  createdById String
  archivedAt  DateTime?
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   ChannelMember[]
  messages  Message[]
  callTranscripts CallTranscript[]

  @@unique([workspaceId, name])
  @@index([workspaceId, deletedAt])
  @@index([type])
  @@map("channels")
}

model ChannelMember {
  id         String    @id @default(cuid())
  channelId  String
  userId     String
  role       String    @default("member")
  lastReadAt DateTime?
  isMuted    Boolean   @default(false)
  joinedAt   DateTime  @default(now())
  leftAt     DateTime?

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
  @@index([channelId])
  @@map("channel_members")
}

// ─── Messages ─────────────────────────────────────────────────────────────────

model Message {
  id        String    @id @default(cuid())
  channelId String
  authorId  String
  content   String
  threadId  String?
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  channel     Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author      User              @relation(fields: [authorId], references: [id])
  thread      Thread?           @relation(fields: [threadId], references: [id])
  reactions   MessageReaction[]
  attachments Attachment[]
  workGraphEdges WorkGraphEdge[] @relation("TargetMessage")

  @@index([channelId, createdAt(sort: Desc)])
  @@index([channelId, deletedAt])
  @@index([authorId])
  @@index([threadId])
  @@map("messages")
}

model Thread {
  id          String    @id @default(cuid())
  messageId   String?   @unique
  channelId   String
  lastReplyAt DateTime?
  createdAt   DateTime  @default(now())

  messages Message[]

  @@index([channelId])
  @@map("threads")
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

model Attachment {
  id        String   @id @default(cuid())
  name      String
  url       String
  mimeType  String
  size      Int
  uploadedById String
  messageId String?
  createdAt DateTime @default(now())

  message Message? @relation(fields: [messageId], references: [id])

  @@index([messageId])
  @@map("attachments")
}

// ─── Documents ────────────────────────────────────────────────────────────────

model Document {
  id             String    @id @default(cuid())
  workspaceId    String
  title          String
  icon           String?
  parentId       String?
  isPublic       Boolean   @default(false)
  createdById    String
  lastEditedById String
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User              @relation("DocCreatedBy", fields: [createdById], references: [id])
  lastEditedBy User              @relation("DocLastEditedBy", fields: [lastEditedById], references: [id])
  parent       Document?         @relation("DocHierarchy", fields: [parentId], references: [id])
  children     Document[]        @relation("DocHierarchy")
  blocks       DocumentBlock[]
  versions     DocumentVersion[]
  yjsState     DocumentYjsState?
  workGraphEdges WorkGraphEdge[] @relation("TargetDocument")

  @@index([workspaceId, deletedAt])
  @@index([parentId])
  @@index([updatedAt(sort: Desc)])
  @@map("documents")
}

model DocumentBlock {
  id            String    @id @default(cuid())
  documentId    String
  type          BlockType
  content       Json
  order         Float
  parentBlockId String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, deletedAt])
  @@index([documentId, order])
  @@map("document_blocks")
}

model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  blocks      Json
  createdById String
  createdAt   DateTime @default(now())

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([documentId, createdAt(sort: Desc)])
  @@map("document_versions")
}

// PRD_AUDIT.md Finding #1 fix: stores the Yjs CRDT document state, closing
// the gap where docs/index.ts previously did last-write-wins full block
// replacement while a comment falsely claimed CRDT deltas were handled at
// the WS layer. Per PRD §16's exact storage spec: Yjs update state as a
// bytea column in PostgreSQL, with S3 overflow for documents whose
// encoded state exceeds a size threshold (large docs with long edit
// history can produce a state vector too large to comfortably keep
// inline — see s3Key below).
//
// One row per document. `state` holds the full merged Yjs document state
// (Y.encodeStateAsUpdate), updated via debounced persistence from the WS
// sync layer in routes/ws/index.ts, not on every keystroke — Yjs's CRDT
// merge guarantees mean we only need to persist a periodic snapshot of
// the merged state, not every individual update, since any client that
// reconnects can resync from this snapshot plus is brought current by
// any updates broadcast since.
model DocumentYjsState {
  id         String   @id @default(cuid())
  documentId String   @unique
  // Inline Yjs state (Y.encodeStateAsUpdate output). Null when the state
  // has overflowed to S3 — see s3Key.
  state      Bytes?
  // Set when `state` exceeds the inline-size threshold (see
  // YJS_INLINE_STATE_MAX_BYTES in utils/env.ts). When set, `state` above
  // is null and the actual bytes live at this S3 key instead.
  s3Key      String?
  // Byte length of the encoded state, tracked independently of whether
  // it's stored inline or in S3, so size-threshold decisions don't
  // require fetching the blob first.
  sizeBytes  Int      @default(0)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_yjs_state")
}

// ─── Tasks ────────────────────────────────────────────────────────────────────

model Project {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  description String?
  color       String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([workspaceId, deletedAt])
  @@map("projects")
}

model Task {
  id          String       @id @default(cuid())
  workspaceId String
  projectId   String?
  title       String
  description String?
  status      TaskStatus   @default(todo)
  priority    TaskPriority @default(medium)
  assigneeId  String?
  createdById String
  dueDate     DateTime?
  tags        String[]     @default([])
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace  Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project    Project?     @relation(fields: [projectId], references: [id])
  assignee   User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy  User         @relation("TaskCreatedBy", fields: [createdById], references: [id])
  comments   TaskComment[]
  workGraphEdges WorkGraphEdge[] @relation("TargetTask")

  @@index([workspaceId, status, deletedAt])
  @@index([workspaceId, assigneeId])
  @@index([workspaceId, dueDate])
  @@index([projectId])
  @@index([createdAt(sort: Desc)])
  @@map("tasks")
}

model TaskComment {
  id        String    @id @default(cuid())
  taskId    String
  authorId  String
  content   String
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId, deletedAt])
  @@map("task_comments")
}

// ─── Canvas ───────────────────────────────────────────────────────────────────

model Canvas {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  thumbnail   String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  nodes     CanvasNode[]

  @@index([workspaceId, deletedAt])
  @@map("canvases")
}

model CanvasNode {
  id       String @id @default(cuid())
  canvasId String
  type     String
  content  Json
  x        Float
  y        Float
  width    Float
  height   Float

  canvas Canvas @relation(fields: [canvasId], references: [id], onDelete: Cascade)

  @@index([canvasId])
  @@map("canvas_nodes")
}

// ─── Work Graph ───────────────────────────────────────────────────────────────

model WorkGraphEdge {
  id          String   @id @default(cuid())
  workspaceId String
  sourceType  String
  sourceId    String
  targetType  String
  targetId    String
  edgeType    EdgeType
  createdById String
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  User      @relation("EdgeCreatedBy", fields: [createdById], references: [id])
  targetMessage  Message?  @relation("TargetMessage", fields: [targetId], references: [id], map: "fk_edge_target_message")
  targetTask     Task?     @relation("TargetTask", fields: [targetId], references: [id], map: "fk_edge_target_task")
  targetDocument Document? @relation("TargetDocument", fields: [targetId], references: [id], map: "fk_edge_target_doc")
  target WorkGraphNode? @relation(fields: [targetId], references: [entityId])

  @@index([workspaceId, sourceType, sourceId])
  @@index([workspaceId, targetType, targetId])
  @@index([edgeType])
  @@index([createdAt(sort: Desc)])
  @@map("work_graph_edges")
}

model WorkGraphNode {
  id         String   @id @default(cuid())
  entityType String
  entityId   String   @unique
  workspaceId String
  embedding  Float[]  // pgvector — 1536 dimensions for semantic search
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  edges WorkGraphEdge[]

  @@index([workspaceId, entityType])
  @@index([entityId])
  @@map("work_graph_nodes")
}

// ─── Audit Logs ───────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String?
  action      String
  ipAddress   String
  userAgent   String
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ─── SSO Configuration ────────────────────────────────────────────────────────

model WorkspaceSsoConfig {
  id              String   @id @default(cuid())
  workspaceId     String   @unique
  provider        String   // 'saml' | 'oidc'
  entityId        String
  ssoUrl          String
  certificate     String   @db.Text  // PEM, encrypted at rest
  attributeMapping Json    @default("{}")
  enabled         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("workspace_sso_configs")
}

// ─── Notifications ────────────────────────────────────────────────────────────

enum NotificationType {
  mention
  thread_reply
  task_assigned
  task_status_changed
  task_comment
  workspace_invite
  workspace_member_joined
  channel_added
  doc_shared
  ai_digest_ready
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  workspaceId String?
  type        NotificationType
  title       String
  body        String
  entityType  String?          // 'message' | 'task' | 'doc' | 'channel'
  entityId    String?
  entityUrl   String?
  read        Boolean          @default(false)
  readAt      DateTime?
  emailSent   Boolean          @default(false)
  createdAt   DateTime         @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([workspaceId])
  @@map("notifications")
}

// ─── Call Transcripts ─────────────────────────────────────────────────────────
// PRD_AUDIT.md Finding #2: closes the P0 gap where meeting transcription
// and AI summarization didn't exist at all — no transcript capture, no
// POST /v1/ai/meeting/summary endpoint (PRD §17's exact specified path),
// and call-panel.tsx had zero recording/transcription of any kind.
//
// Capture mechanism: client-side, using the browser's native Web Speech
// API (available in Chromium-based browsers with no external service
// dependency), not server-side LiveKit egress + a hosted transcription
// service. This is a real, documented scope choice: LiveKit egress
// recording + a Whisper-class transcription pipeline is a substantially
// larger infrastructure undertaking (recording storage, a transcription
// worker, speaker diarization) that belongs in its own dedicated build,
// not bundled silently into this fix. What's delivered here is a genuine,
// working P0 capability — auto-transcribe, summarize, extract decisions
// and action items — using a mechanism honest about its own limits
// (Chromium-only, best-effort accuracy, no speaker diarization beyond
// which browser tab sent which segment).

model CallTranscript {
  id          String    @id @default(cuid())
  channelId   String
  // Identifies one call session — generated on first join, shared by
  // every participant's client for the duration of that call, and by
  // every segment + the eventual summary. Distinct from `id` above so a
  // channel's full transcript history is queryable by channelId while
  // still being able to isolate a single session by callId.
  callId      String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  summary     String?   @db.Text
  decisions   Json?     // string[] once summarized
  actionItems Json?     // Array<{ task: string; owner: string | null }> once summarized, mirrors /v1/ai/summarize's shape
  summarizedAt DateTime?

  channel  Channel                @relation(fields: [channelId], references: [id], onDelete: Cascade)
  segments CallTranscriptSegment[]

  @@unique([callId])
  @@index([channelId, startedAt(sort: Desc)])
  @@map("call_transcripts")
}

model CallTranscriptSegment {
  id           String   @id @default(cuid())
  transcriptId String
  speakerId    String   // userId of whoever's client captured this segment
  speakerName  String   // denormalized, so the segment remains readable even if the user is later deleted
  text         String   @db.Text
  spokenAt     DateTime @default(now())

  transcript CallTranscript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([transcriptId, spokenAt(sort: Asc)])
  @@map("call_transcript_segments")
}

// ─── Bookmarks ────────────────────────────────────────────────────────────────

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  entityType String   // 'message' | 'task' | 'doc' | 'canvas_node'
  entityId   String
  note       String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("bookmarks")
}

// ─── API Keys ─────────────────────────────────────────────────────────────────

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  name        String
  keyHash     String    @unique  // SHA-256 of the actual key — never store plaintext
  keyPrefix   String             // first 8 chars for display (e.g. "csk_live_")
  scopes      String[]  @default([])
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([keyHash])
  @@map("api_keys")
}

// ─── Webhook Endpoints ────────────────────────────────────────────────────────

model WebhookEndpoint {
  id          String    @id @default(cuid())
  workspaceId String
  url         String
  secret      String    // HMAC signing secret (encrypted)
  events      String[]  @default([])
  enabled     Boolean   @default(true)
  failureCount Int      @default(0)
  lastDeliveryAt DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([workspaceId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  endpointId String
  event      String
  payload    Json
  statusCode Int?
  response   String?
  duration   Int?     // ms
  success    Boolean
  attemptCount Int    @default(1)
  createdAt  DateTime @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt(sort: Desc)])
  @@map("webhook_deliveries")
}

// ─── User Notification Preferences ───────────────────────────────────────────

model UserNotificationPrefs {
  id                String  @id @default(cuid())
  userId            String  @unique
  mentions          Boolean @default(true)
  threadReplies     Boolean @default(true)
  taskAssigned      Boolean @default(true)
  taskUpdates       Boolean @default(false)
  weeklyDigest      Boolean @default(true)
  emailNotifications Boolean @default(true)
  pushEnabled       Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification_prefs")
}

// ─── SCIM Tokens ─────────────────────────────────────────────────────────────

model ScimToken {
  id          String    @id @default(cuid())
  workspaceId String
  tokenHash   String    @unique
  description String
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("scim_tokens")
}

// ─── Super Admin Audit Log ────────────────────────────────────────────────────
// Platform-level actions, deliberately separate from the workspace-scoped
// AuditLog model above. A super admin's actions (suspending a workspace,
// impersonating a user, granting another super admin) are not tied to any
// single workspace's lifecycle — this log must survive even if the
// workspace or user it acted on is later hard-deleted, so we store
// targetWorkspaceId/targetUserId as plain strings (no foreign key, no
// cascade) rather than relations. Append-only; nothing here is ever
// updated or deleted by the application.

enum SuperAdminAction {
  workspace_suspended
  workspace_reactivated
  workspace_plan_changed
  workspace_deleted
  user_suspended
  user_reactivated
  user_impersonation_started
  user_impersonation_ended
  super_admin_granted
  super_admin_revoked
  system_setting_changed
}

model SuperAdminAuditLog {
  id               String           @id @default(cuid())
  actorId          String           // the super admin who performed the action
  actorEmail       String           // denormalized — survives actor account deletion
  action           SuperAdminAction
  targetWorkspaceId String?
  targetUserId      String?
  metadata         Json             @default("{}")
  ipAddress        String
  userAgent        String
  createdAt        DateTime         @default(now())

  @@index([actorId, createdAt(sort: Desc)])
  @@index([targetWorkspaceId])
  @@index([targetUserId])
  @@index([action, createdAt(sort: Desc)])
  @@map("super_admin_audit_logs")
}

// ─── Right-to-Erasure Requests ─────────────────────────────────────────────────
// PRD_AUDIT.md Finding #7: PRD §19's GDPR right-to-erasure requirement.
// Deliberately no @relation to User — this table must survive after the
// user row it describes has actually been erased.
model ErasureRequest {
  id              String    @id @default(cuid())
  userId          String
  requesterEmail  String
  status          String    @default("pending") // pending | completed | failed
  requestedAt     DateTime  @default(now())
  completedAt     DateTime?
  notes           String?

  @@index([userId])
  @@index([status])
  @@map("erasure_requests")
}
